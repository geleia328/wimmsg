+def recognize_pil_text(image, language: str) -> str:
+    """Run winocr 0.0.15 synchronously and normalize its dict result."""
+    if not HAS_WINOCR or winocr is None:
+        raise RuntimeError("winocr não está disponível neste executável")
+    recognize_sync = getattr(winocr, "recognize_pil_sync", None)
+    if not callable(recognize_sync):
+        exposed = ", ".join(
+            name for name in dir(winocr) if name.startswith("recognize_pil")
+        )
+        raise RuntimeError(
+            "winocr incompatível: recognize_pil_sync ausente; APIs: " + exposed
+        )
+    candidates = []
+    for candidate in (
+        language,
+        language.split("-", 1)[0] if "-" in language else language,
+        "en-US",
+        "en",
+    ):
+        if candidate and candidate not in candidates:
+            candidates.append(candidate)
+    last_error = None
+    for candidate in candidates:
+        try:
+            result = recognize_sync(image, candidate)
+            if isinstance(result, dict):
+                return str(result.get("text", "") or "")
+            return str(getattr(result, "text", "") or "")
+        except Exception as error:
+            last_error = error
+    raise RuntimeError(f"nenhum idioma OCR disponível: {last_error}")
+
 try:
