# Conexão com o Postgres (Neon, Supabase ou local)
DATABASE_URL=postgresql://user:password@host:5432/database

# Token que o bridge envia em "Authorization: Bearer ...".
# O painel recusa requisições sem esse token.
BRIDGE_TOKEN=

# (Opcional) URL direta do .exe no GitHub Releases.
# O botão "Baixar BakersWhisper.exe" no site aponta pra cá.
# Exemplo: https://github.com/SEU_USUARIO/bakers-whisper/releases/latest/download/BakersWhisper.exe
BRIDGE_EXE_URL=
