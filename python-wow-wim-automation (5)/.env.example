# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commite o `.env` de verdade — o .gitignore já protege ele.

# Postgres — em produção use a Pooled connection string do Neon.tech
# (com "-pooler" no hostname), ex.:
#   postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Segredo compartilhado entre o site e o Python bridge.
# Deixe vazio em desenvolvimento local; OBRIGATÓRIO em produção.
# Gere um valor forte com:  openssl rand -hex 32
BRIDGE_TOKEN=
